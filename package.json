    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "icon": "./icon.png",
  "files": [
    "lib",
    "gallery",
    "examples",
    "skills",
    "cordis.patch.yml",
    "icon.png",
    "LICENSE",
    "README.md"
  ],
  "displayName": "人物情报库",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "character-profile",
    "dossier",
    "knowledge-base",
    "research",
    "ui",
    "tool",
    "document"
  ],
  "author": "lilongyi",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.4.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
